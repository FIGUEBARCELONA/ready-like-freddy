  },
  "uniquenessPolicy": {
    "candidateOnly": true,
    "canonicalProductRequiresEvidence": true,
    "deduplicateBy": ["productCode", "colourCode", "modelName", "sourceSha256"]
  },
  "stageGates": {
    "discoveryRequiresUniqueProductIdentities": 50,
    "productStageRequiresAllSelectedIdentities": true,
    "canonicalProductsRemainZeroUntilCrossSourceDeduplication": true,
    "factoryVerifiedCountRemainsZeroWithoutIndependentEvidence": true
